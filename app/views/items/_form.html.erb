<%= simple_form_for item do |f| %>
  <%= f.input :name %>
  <%= f.input :description %>
  <%= f.select :category, [  "baby", "sport & outdoors", "electronics", "books", "videogrames", "toys", "luggage", "men’s fashion", "women’s fashion", "pet supplies" ] %>
  <%= f.input :location %>
  <%= f.input :photo, as: :file %>
  <%= f.submit %>
<% end %>
