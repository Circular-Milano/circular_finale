<section id="section01" class="section">
  <div class="home-banner">
    <h1 id="home-header"><strong>Circular</strong></h1>
    <span id="banner-typed-text"></span>
    <title>Search Bar</title>
    <div class="container">
      <div class="row row-no-gutters">
        <div class="col-sm-11">
          <%= form_tag items_path, method: :get do %>
          <%= text_field_tag :query,
            params[:query],
            class: "form-control",
            placeholder: "what do you want to borrow today?" %>
        </div>
        <div class="col-sm-1 search-btn-container">
          <%= submit_tag "Search", class: "btn btn-primary", id: "submit" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="scroll-down-button scrollable">
  <a href="#section02"><span></span>Scroll</a>
  </div>
</section>

<section id="section02" class="section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10 col-md-10 col-sm-10 col-xs-12 col-lg-push-2 col-md-push-2 col-sm-push-2">
        <h1>How does it work?</h1>
        <div>
          <p id="home-description">
            <b>Circular</b> is a peer-to-peer rental marketplace. We empower our members to embrace the sharing economy and avoid making unnecessary purchases. Anyone can post their items on Circular for people in their community to rent.
          </p>
        </div>
        <p>
          Do you want to share your things with the world? Renting items with Circular is easy, safe and fast, so you can borrow items you need and lend items you don’t.
        </p>
      </div>
    </div>
  </div>
  <div class="scroll-down-button scrollable">
  <a href="#section03"><span></span>Scroll</a>
  </div>
</section>

