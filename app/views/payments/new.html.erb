<!-- app/views/payments/new.html.erb -->
<div class="payment-container">


              <div class="card-product bg-white mx-auto">
                <%= cl_image_tag @order.item.photo.key, height: 100, width: 100, crop: :fill if  @order.item.photo.attached? %>
                <div class="card-product-infos">
                  <p>Purchase of <strong><%= @order.item.name %></strong> for <strong><%= humanized_money_with_symbol @order.amount_cents * 0.01 %></strong></p>
                  <p class="item-category"><strong><%= @order.item.category %></strong></p>
                  <p><%= @order.item.description %></p>
                    <button id="pay" class="btn btn-primary">Pay</button>
                          <script src="https://js.stripe.com/v3/"></script>
                          <script>
                            const paymentButton = document.getElementById('pay');
                            paymentButton.addEventListener('click', () => {
                              const stripe = Stripe('<%= ENV['STRIPE_PUBLISHABLE_KEY'] %>');
                              stripe.redirectToCheckout({
                                sessionId: '<%= @order.checkout_session_id %>'
                              });
                            });
                          </script>                </div>
              </div>
</div>
