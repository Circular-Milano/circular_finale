<%= simple_form_for item do |f| %>
  <%= f.input :name %>
  <%= f.input :description %>
  <%= f.input :price_cents %>
  <%= f.select :category, [  "Baby", "Sport & outdoors", "Electronics", "Books", "Videogrames", "Toys", "Luggage", "Men’s fashion", "Women’s fashion", "Pet supplies", "Music", "Health" ] %>
  <%= f.input :location %>
  <label class="btn btn-primary circular-button">
    Add a photo
    <span style="display:none;">
    <%= f.input :photo, as: :file %>
    </span>
  </label>
  <label class="btn btn-primary circular-button">
  Create Item
  <span style="display:none;">
    <%= f.submit %>
  </span>
</label>
<% end %>
