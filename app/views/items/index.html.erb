<%= render "shared/navbar" %>


<div id="header">
    <div class="row">
    </div>
</div>


  <div class="container" id="space">
    <div class="row">
    <% @items.each do |item| %>
    <div class="col-sm-4">
      <div class="card bg-white p-3">
        <h5><%= link_to item.name, item_path(item) %> 
        <p><%= item.description %></p>
        <p><%= item.category %></p>
      </div>
    </div>
    <% end %>
  </div>
</div>