
<section id="section01" class="section">
  <div class="home-banner">
  <div id="home-header">
    <span id="sp">"I DON'T WANT OBJECTS, </span><span id="sp" style="color:#4B88FE">I </span><span id="sp">WANT THE </span><span id="sp" style="color:#4B88FE">FEELING THAT COMES WITH IT "</span>
    </div>
    <span id="banner-typed-text"></span>
    <title>Search Bar</title>
    <div class="container-fluid">
        <div class="circular-searchbar">
          <%= form_tag items_path, method: :get, class: "d-flex" do %>
          <%= text_field_tag :query,
            params[:query],
            class: "form-control",
            placeholder: "what do you want to borrow today?" %>
            <%= submit_tag "Search", id: "submit" %>
            <% end %>
        </div>
    </div>
  </div>
  <div class="scroll-down-button-white scrollable">
  <a href="#section02"><span></span></a>
  </div>
</section>

<section id="section02" class="section container-fluid">
  <div class="row section02-container">

    <div class="col-sm-12 col-md-12 col-lg-12 desc-items">
      <div class="home-description">
        <h1>How does it work?</h1>
        <p>
          Have something you want to share with the world? Renting with CIRCULAR is easy, flexible, secured and fast so borrow items you need and lend items you don’t.
        </p>
      </div>
    </div>

    <%# <div class="container-fluid"> %>
      <div class="col-sm-3 col-md-3 col-lg-3 how-to-container">
        <div class="icon-container">
          <%= image_tag("icons/find.svg") %>
          <%# <%= image_tag "massimo galeotti.png", class: "icon-container" %>
        </div>
        <h2>FIND</h2>
        <p>
          Browse through tons of items for rent.
        </p>
      </div>

      <div class="col-sm-3 col-md-3 col-lg-3 how-to-container">
        <div class="icon-container">
          <%= image_tag("icons/book.svg") %>
        </div>
        <h2>BOOK</h2>
        <p>
          Schedule rental for as long as you need.
        </p>
      </div>

      <div class="col-sm-3 col-md-3 col-lg-3 how-to-container">
        <div class="icon-container">
          <%= image_tag("icons/use.svg") %>
        </div>
        <h2>USE</h2>
        <p>
          Enjoy your rental as you please.
        </p>
      </div>

      <div class="col-sm-3 col-md-3 col-lg-3 how-to-container">
        <div class="icon-container">
          <%= image_tag("icons/return.svg") %>
        </div>
        <h2>RETURN</h2>
        <p>
          Return item in its original condition.
        </p>
      </div>
    <%# </div> %>

  </div>
  <div class="scroll-down-button-black scrollable">
  <a href="#section03"><span></span></a>
  </div>
</section>

