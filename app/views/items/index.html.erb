<%= render "shared/navbar" %>



<div class="container">
  <div class="row">

  <% @items.each do |item| %>
  <div class="col-sm-4">
    <h5><%= link_to item.name, item_path(item) %> <%= '⭐️' * item.rating %></h5>
    <p><%= item.description %></p>
    <p><%= item.category %></p>
  </div>
  <% end %>
</div>




<%= link_to "Create a new Items", new_item_path %> <%= link_to "Back to Circular", home_path %>
