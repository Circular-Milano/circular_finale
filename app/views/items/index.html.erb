<%= render "shared/navbar" %>


<div id="header">
    <div class="row">
    </div>
</div>


  <div class="mt-5">
    <div class="d-flex justify-content-between">
        <div class="row w-50">
          <% @items.each do |item| %>
            <div class="col-sm-6">
              <div class="card bg-white p-3">
                <h5><%= link_to item.name, item_path(item) %> 
                <%= cl_image_tag item.photo.key, height: 300, width: 400, crop: :fill if  item.photo.attached? %>
                <div>
                  <p><%= item.description %></p>
                  <p><%= item.category %></p>
                </div>

              </div>
            </div>
          <% end %>
        </div>



      <div id="map"
          style="width: 50%; height: 100vh;"
          data-markers="<%= @markers.to_json %>"
          data-mapbox-api-key="<%= ENV['MAPBOX_API_KEY'] %>">
      </div>
    </div>
  </div>