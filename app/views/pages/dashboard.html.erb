<div class="mt-5 circular-dashboard">
  <% current_user.orders.each do |order| %>
    <div class="card bg-white p-3">
              <h1>Order <%= order.id %> <small><span class="badge badge-primary"><%= order.state %></span></small></h1>
              <ul class="list-unstyled">
                <li><strong>Item</strong> <%= order.item.name %> </li>
                <li><strong>TOTAL</strong> <%= humanized_money_with_symbol order.amount %></li>
                </li>
              </ul>
              <p>Estimated delivery in <strong>2 business days</strong></p>
              <% if order.review.nil? %>
      <%= link_to "add a review", new_order_review_path(order) %>
      <% else  %>
      <p><%= order.review.content %></p>
      <p><%= '⭐️' * order.review.rating %></p>
      <% end  %>
    </div>
  <% end %>
    <div class="container">
      <div class="d-flex justify-content-between" style="margin-bottom: 40px; margin-left: 20px;">
        <div class="row w-50">
          <% current_user.items.each do |item| %>
            <div class="col-sm-6 item dashboard-item-photo" data-category="<%= item.category %>">
              <div class="card-product bg-white p-3" id="padre">
                <h5><%= link_to item.name, item_path(item) %>
                <%= cl_image_tag item.photo.key, height: 100, width: 100, crop: :fit if  item.photo.attached? %>
                <div class="card-product-infos">
                  <p><%= item.description %></p>
                  <p><%= item.category %></p>
                  <p>Amount: <%= humanized_money_with_symbol(item.price) %></p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
</div>
