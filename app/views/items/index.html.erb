<%= render "shared/navbar" %>


<div id="header">
    <div class="row">
    </div>
</div>
[  "baby", "sport & outdoors", "electronics", "books", "videogrames", "toys", "luggage", "men’s fashion", "women’s fashion", "pet supplies" ]
<div class="categories mt-5">
  <button type="button" class="btn btn-outline-primary btn-category" value="All">All</button>
  <button type="button" class="btn btn-outline-primary btn-category" value="Baby">Baby</button>
  <button type="button" class="btn btn-outline-primary btn-category" value="Sport & outdoors">Sport & outdoors</button>
  <button type="button" class="btn btn-outline-primary btn-category" value="Electronics">Electronics</button>
  <button type="button" class="btn btn-outline-primary btn-category" value="Books">Books</button>
  <button type="button" class="btn btn-outline-primary btn-category" value="Videogrames">Videogrames</button>
  <button type="button" class="btn btn-outline-primary btn-category" value="Toys">Toys</button>
  <button type="button" class="btn btn-outline-primary btn-category" value="Luggage">Luggage</button>
  <button type="button" class="btn btn-outline-primary btn-category" value="Men’s fashiony">Men’s fashiony</button>
  <button type="button" class="btn btn-outline-primary btn-category" value="Women’s fashion">Women’s fashion</button>
  <button type="button" class="btn btn-outline-primary btn-category" value="Pet supplies">Pet supplies</button>

</div>


  <div class="mt-5">
    <div class="d-flex justify-content-between" style="margin-bottom: 40px; margin-left: 20px;">
        <div class="row w-50">
          <% @items.each do |item| %>
            <div class="col-sm-6 item" data-category="<%= item.category %>">
              <div class="card-product bg-white p-3" id="padre">
                <h5><%= link_to item.name, item_path(item) %>
                <%= cl_image_tag item.photo.key, height: 100, width: 100, crop: :fill if  item.photo.attached? %>
                <div class="card-product-infos">
                  <p><%= item.description %></p>
                  <p><%= item.category %></p>
                  <p>Amount: <%= humanized_money_with_symbol(item.price) %></p>
                </div>

              </div>
            </div>
          <% end %>
        </div>





      <div id="map"
          style="width: 50%; height: 100vh; margin-top: 15px; margin-right: 20px; box-shadow: 0 0 15px rgba(0,0,0,0.2);"
          data-markers="<%= @markers.to_json %>"
          data-mapbox-api-key="<%= ENV['MAPBOX_API_KEY'] %>">
      </div>
    </div>
  </div>
