<div class="navbar navbar-expand-sm navbar-light fixed-top navbar-lewagon-dark">
  <%= link_to home_path, class: "navbar-brand" do %>
    <%= image_tag ("New.png") %>
    <% end %>

  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>


  <div class="collapse navbar-collapse" id="navbar-example">
    <ul class="navbar-nav mr-auto">
     <% if user_signed_in? %>

      <li class="nav-item nav-item-circular">
        <%= link_to "About Circular", about_path, class: "nav-link" %>
      </li>

      <li class="nav-item nav-item-circular">
        <%= link_to "Circular Store", items_path, class: "nav-link" %>
      </li>


      <li class="nav-item nav-item-circular" class="active" href="#carousel">
        <%= link_to "Create a new Item", new_item_path, class: "nav-link" %>
      </li>

      <li class="nav-item dropdown">
        <%= image_tag ("bo.jpeg"), class: "avatar dropdown-toggle", id: "navbarDropdown", data: { toggle: "dropdown" }, 'aria-haspopup': true, 'aria-expanded': false %>
        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
          <%= link_to "Dashboard", dashboard_path, class: "dropdown-item" %>
          <%= link_to "Log out", destroy_user_session_path, method: :delete, class: "dropdown-item" %>
        </div>
      </li>
    <% else %>
    <li class="nav-item">
      <%= link_to "About Circular", about_path, class: "nav-link" %>
    </li>

    <li class="nav-item">
      <%= link_to "Circular Store", items_path, class: "nav-link" %>
    </li>

      <li class="nav-item">
        <%= link_to "Login", new_user_session_path, class: "nav-link" %>
      </li>
    <% end %>
    </ul>
  </div>
</div>








